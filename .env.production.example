# Copy to .env.production on the server and fill in every CHANGE_ME.
#   cp .env.production.example .env.production && chmod 600 .env.production
# Generate secrets with:  openssl rand -base64 48

# --- Exposing the API (set the one matching your --profile) ---
# caddy profile: server has a public IPv4; Caddy issues the HTTPS certificate for this domain
API_DOMAIN=api.example.com
# tunnel profile: NAT VPS; token from Cloudflare Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# --- App ---
# PORT is fixed to 4000 in docker-compose.prod.yml (Caddy proxies to it), so it isn't set here.
API_PREFIX=api/v1
FRONTEND_URL=https://example.com
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=https://example.com,https://www.example.com

# --- Database ---
# Managed database (Prisma Postgres, Neon, Render...): set DATABASE_URL and leave DB_* out.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Postgres on this server instead (docker-compose.db.yml): remove DATABASE_URL and set these.
# DB_USERNAME=boda
# DB_PASSWORD=CHANGE_ME
# DB_NAME=boda
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Redis (bundled container; password is required) ---
REDIS_PASSWORD=CHANGE_ME

# --- JWT ---
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# --- Storage ---
# s3 is recommended (Cloudflare R2 / AWS S3 / any S3-compatible). For R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   S3_PUBLIC_URL=https://<your public bucket or custom domain>
# "local" keeps files in Docker volumes on this server (back them up yourself).
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=boda-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# --- Mail (real SMTP provider: Brevo, Resend, SES, Zoho...) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="BODA <no-reply@example.com>"
MAIL_SECURE=false
SUPPORT_EMAIL=contactus@bodaborcha.in

# --- Google sign-in (same client ID as the frontend) ---
GOOGLE_CLIENT_ID=

# --- Barcode lookup ---
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=BODA/1.0 (contactus@bodaborcha.in)

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Admin seed ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME
