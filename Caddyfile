# Caddy fetches and renews a Let's Encrypt certificate for API_DOMAIN automatically.
# Point the domain's DNS A record at the server before the first start.
{$API_DOMAIN} {
	# Proxies plain HTTP and socket.io WebSocket upgrades alike.
	reverse_proxy backend:4000

	# Uploads are capped in the API too; this rejects oversized bodies earlier.
	request_body {
		max_size 20MB
	}
}
