# App
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database — either set DATABASE_URL (the single connection string a cloud provider gives you,
# e.g. postgresql://user:password@host:5432/dbname?sslmode=require), which then overrides
# DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_NAME, or set those parts for a local Postgres.
# SSL: on by default with DATABASE_URL, off for the parts. DB_SSL=true|false forces it. An
# sslmode=... inside the URL takes priority over DB_SSL / DB_SSL_REJECT_UNAUTHORIZED.
# If the provider's certificate fails to verify ("self-signed certificate in certificate
# chain"), set DB_SSL_REJECT_UNAUTHORIZED=false, or use sslmode=no-verify in the URL.
# Migrations and seeds read the same settings, so they run against the same database.
# DATABASE_URL=
# DB_SSL=
# DB_SSL_REJECT_UNAUTHORIZED=true
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=boda
DB_PASSWORD=boda_dev_pass
DB_NAME=boda_dev
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Storage (local | s3) - "local" writes to disk under UPLOAD_DIR, "s3" targets AWS S3 or an S3-compatible
# endpoint such as MinIO (set S3_ENDPOINT to the MinIO URL, e.g. http://localhost:9000)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Private files (prescriptions). Local driver: a directory that is NOT served under /uploads.
# S3 driver: stored in the same bucket under the private/ prefix — keep that prefix out of any
# public-read bucket policy in production.
PRIVATE_UPLOAD_DIR=./private-uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=boda-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# Mail (SMTP) - dev default: Mailpit (`docker compose up -d mailpit`, inbox at http://localhost:8025);
# set real SMTP creds to deliver for real. Order and store notifications are emailed too.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="BODA <no-reply@boda.local>"
MAIL_SECURE=false
# Inbox that receives contact-form messages (POST /contact)
SUPPORT_EMAIL=support@boda.local

# Google sign-in — OAuth 2.0 "Web application" client ID from Google Cloud Console
# (APIs & Services → Credentials). Use the same value as the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. Add http://localhost:3000 as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=

# Barcode lookup for sellers adding products: Open Food Facts (free, no key). They ask for a
# User-Agent naming the app and a contact address. Data is ODbL, images CC BY-SA.
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=BODA/1.0 (support@boda.local)

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Admin seed
SEED_ADMIN_EMAIL=admin@boda.local
SEED_ADMIN_PASSWORD=ChangeMe123!
